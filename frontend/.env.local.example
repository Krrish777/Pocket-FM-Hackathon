# Copy to `.env.local` (gitignored) to point the UI at the real backend.

# Mock is the default and the stage-safe setting: the whole demo runs with zero
# backend, which is what REQUIREMENTS.md §10 requires if venue wifi fails.
# Set to "false" ONLY when the Canon Kernel is running and its contract matches
# docs/API_CONTRACT_NOTES.md.
NEXT_PUBLIC_USE_MOCK=true

# Where the Route Handler proxy forwards /api/* once mocks are off.
BACKEND_URL=http://localhost:8000
