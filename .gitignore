# Secrets — NEVER commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Local SQLite databases (created at runtime by bootstrap)
*.db
*.sqlite3

# Environments
.venv/
venv/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data artifacts (keep the folders via .gitkeep, ignore contents)
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep

# Eval / run outputs
evals/reports/

# Notebooks scratch
.ipynb_checkpoints/

# Databricks AI Dev Kit (installed via install.ps1 --tools claude --skills-profile all)
# Install state + MCP config are machine-local: .mcp.json hardcodes absolute paths into
# ~/.ai-dev-kit/.venv, so it is not portable to another machine. Reproduce with:
#   irm https://raw.githubusercontent.com/databricks-solutions/ai-dev-kit/main/install.ps1 -OutFile install.ps1
#   .\install.ps1 --tools claude --skills-profile all
.ai-dev-kit/
.mcp.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
temp/