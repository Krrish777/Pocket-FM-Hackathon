# Copy to `.env` (gitignored) and fill in real values. NEVER commit real secrets.
# Loaded via pydantic-settings (see src/story_engine/config/settings.py). Plain names, no prefix.

# --- LLM provider (OpenAI is the wired default; see settings.llm_provider) ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Optional overrides (defaults live in settings.py; uncomment to change) ---
# LLM_PROVIDER=openai        # `scripted` = deterministic offline fallback, no key needed
# DEFAULT_MODEL=gpt-4o
# INTENT_MODEL=gpt-4o-mini
# MAX_OUTPUT_TOKENS=2000
# REQUEST_BUDGET_USD=0.50
# DATABASE_URL=sqlite:///./story_engine.db

# Contact point advertised in the outbound User-Agent for the fanfic harvester.
# Wikimedia rejects requests whose User-Agent carries no contactable URL or email (HTTP 403),
# which silently disables fandom alias expansion. Set this to your own URL or email.
STORY_ENGINE_CONTACT=
